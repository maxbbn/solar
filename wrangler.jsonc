{
  "name": "true-scale-solar-system",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  // `npm run build` writes the hashed, minified site to dist/ (tools/build.mjs).
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  },
  "previews": {}
}
